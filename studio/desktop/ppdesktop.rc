      VALUE "ProductName", "PubPascal Desktop"
      VALUE "ProductVersion", "0.1.0.0"
      VALUE "LegalCopyright", "(c) Isaque Pinheiro"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END

Windows10Dark VCLSTYLE "Windows10Dark.vsf"

