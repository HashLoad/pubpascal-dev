.vscode/
.idea/
*.swp
*~

# OS noise
Thumbs.db
.DS_Store

# Local config / secrets
.env
.env.local
*.local.yaml

# Override the user's global .gitignore — .modules/ IS tracked in this repo
# (it holds vendored upstream sources consumed via git submodules).
!/.modules/
!/.modules/**
